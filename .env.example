# Network to use: "local" (Hardhat node on 127.0.0.1:8545) or "sepolia"
NETWORK=local

# Sepolia network (only needed when NETWORK=sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
PRIVATE_KEY=your_private_key_hex

# Optional: private Sepolia RPC URL used by python/multinode_demo.py
ALCHEMY_SEPOLIA_URL=